# Server
PORT=3001
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=afrifolio

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=30d

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Payment (Mobile Money - à configurer selon le provider)
PAYMENT_PROVIDER_URL=https://api.payment-provider.com
PAYMENT_API_KEY=your_payment_api_key
PAYMENT_WEBHOOK_SECRET=your_webhook_secret

# App
APP_URL=http://localhost:3001
# Prix de l'abonnement Pro en FCFA (lus par l'API et affichés partout sur le site)
SUBSCRIPTION_PRICE=360
# Prix annuel (par défaut : 10 x le prix mensuel = 2 mois offerts)
# SUBSCRIPTION_PRICE_YEARLY=3600
# Commission de parrainage sur chaque paiement (0.10 = 10 %)
COMMISSION_RATE=0.10
# Nombre de photos autorisées avec le plan gratuit
FREE_PLAN_MAX_PHOTOS=12
